{
  "name": "@longtable/public-proposal",
  "version": "0.2.3",
  "description": "Meta-installer scaffold for the LongTable public proposal toolchain.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HosungYou/public-proposal.git",
    "directory": "apps/public-proposal-cli"
  },
  "homepage": "https://github.com/HosungYou/public-proposal#readme",
  "bugs": {
    "url": "https://github.com/HosungYou/public-proposal/issues"
  },
  "keywords": [
    "public-proposal",
    "installer",
    "kpp",
    "codex"
  ],
  "type": "module",
  "files": [
    "dist",
    "marketplace",
    "plugin",
    "worker",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "public-proposal": "dist/main.js"
  },
  "scripts": {
    "build": "node ../../scripts/sync_public_proposal_worker.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@longtable/cli": "0.1.72",
    "@longtable/kpp-cli": "0.3.0",
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
