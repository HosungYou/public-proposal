{
  "name": "@longtable/kpp-cli",
  "version": "0.2.0",
  "description": "KPP CLI for evidence-bound Korean public proposal generation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/HosungYou/public-proposal.git",
    "directory": "apps/kpp-cli"
  },
  "homepage": "https://github.com/HosungYou/public-proposal#readme",
  "bugs": {
    "url": "https://github.com/HosungYou/public-proposal/issues"
  },
  "keywords": [
    "korean",
    "public-proposal",
    "research-service",
    "procurement",
    "evidence",
    "docx",
    "kpp"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kpp": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/mark-executable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@longtable/kpp-audits": "0.2.0",
    "@longtable/kpp-core": "0.2.0",
    "@longtable/kpp-schemas": "0.2.0",
    "commander": "15.0.0",
    "yaml": "2.9.0"
  }
}
