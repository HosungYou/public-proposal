{
  "name": "@longtable/kpp-cli",
  "version": "0.1.0",
  "description": "KPP CLI for evidence-bound Korean public proposal generation.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kpp": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/mark-executable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@longtable/kpp-audits": "0.1.0",
    "@longtable/kpp-core": "0.1.0",
    "@longtable/kpp-schemas": "0.1.0",
    "commander": "15.0.0",
    "yaml": "2.9.0"
  }
}
