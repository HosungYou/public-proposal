{
  "name": "@longtable/kpp-renderers",
  "version": "0.3.0",
  "description": "Deterministic SVG figure renderers for Korean public proposals.",
  "repository": {
    "type": "git",
    "url": "https://github.com/HosungYou/public-proposal.git",
    "directory": "packages/renderers"
  },
  "homepage": "https://github.com/HosungYou/public-proposal#readme",
  "bugs": {
    "url": "https://github.com/HosungYou/public-proposal/issues"
  },
  "keywords": [
    "korean",
    "public-proposal",
    "svg",
    "figures",
    "deterministic",
    "kpp"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "render:fixture": "tsx scripts/render-fixture.ts",
    "verify:pack": "node scripts/verify-pack.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
