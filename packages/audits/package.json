{
  "name": "@longtable/kpp-audits",
  "version": "0.2.0",
  "description": "Technical audit gates for Korean public proposal artifacts.",
  "repository": {
    "type": "git",
    "url": "https://github.com/HosungYou/public-proposal.git",
    "directory": "packages/audits"
  },
  "homepage": "https://github.com/HosungYou/public-proposal#readme",
  "bugs": {
    "url": "https://github.com/HosungYou/public-proposal/issues"
  },
  "keywords": [
    "korean",
    "public-proposal",
    "audit",
    "docx",
    "render",
    "kpp"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@longtable/kpp-core": "0.2.0",
    "@longtable/kpp-renderers": "0.2.0",
    "@longtable/kpp-schemas": "0.2.0"
  }
}
