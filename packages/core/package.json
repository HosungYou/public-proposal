{
  "name": "@longtable/kpp-core",
  "version": "0.1.0",
  "description": "Evidence-bound planning and authoring core for Korean public proposals.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@longtable/kpp-schemas": "0.1.0",
    "yaml": "2.9.0"
  }
}
