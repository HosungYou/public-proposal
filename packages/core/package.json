{
  "name": "@longtable/kpp-core",
  "version": "0.2.1",
  "description": "Evidence-bound planning and authoring core for Korean public proposals.",
  "repository": {
    "type": "git",
    "url": "https://github.com/HosungYou/public-proposal.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/HosungYou/public-proposal#readme",
  "bugs": {
    "url": "https://github.com/HosungYou/public-proposal/issues"
  },
  "keywords": [
    "korean",
    "public-proposal",
    "evidence",
    "provenance",
    "kpp"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@longtable/kpp-schemas": "0.2.1",
    "yaml": "2.9.0"
  }
}
