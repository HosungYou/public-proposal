{
  "name": "@longtable/kpp-schemas",
  "version": "0.2.2",
  "description": "Schemas and contracts for the Korean Public Proposal compiler.",
  "repository": {
    "type": "git",
    "url": "https://github.com/HosungYou/public-proposal.git",
    "directory": "packages/schemas"
  },
  "homepage": "https://github.com/HosungYou/public-proposal#readme",
  "bugs": {
    "url": "https://github.com/HosungYou/public-proposal/issues"
  },
  "keywords": [
    "korean",
    "public-proposal",
    "schemas",
    "evidence",
    "kpp"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
